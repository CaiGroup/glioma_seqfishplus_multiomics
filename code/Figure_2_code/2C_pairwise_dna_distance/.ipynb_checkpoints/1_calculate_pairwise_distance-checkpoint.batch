#!/bin/bash
#SBATCH --time=2-00:00:00
#SBATCH --nodes=1
#SBATCH --gres=gpu:p100:1
#SBATCH --partition=gpu
#SBATCH --mem=200G
#SBATCH -J "gpu_all_loci"
