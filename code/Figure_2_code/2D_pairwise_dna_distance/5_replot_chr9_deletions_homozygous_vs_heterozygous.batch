#!/bin/bash

#SBATCH --ntasks=1
#SBATCH --mem=50G
#SBATCH --cpus-per-task=1
#SBATCH --time=01:00:00
#SBATCH --array=0-2

# Set directories for logs
#SBATCH --output=logs/slurm_out_%A_%a.log
#SBATCH --error=logs/slurm_err_%A_%a.log

# Create the log directory if it doesn't exist
mkdir -p logs

pwd; hostname; date
echo This is task $SLURM_ARRAY_TASK_ID

source ~/miniconda3/bin/activate
conda activate fox_env24
which python

python 5_replot_chr9_deletions_homozygous_vs_heterozygous.py

date
